{
  "name": "pocha-pop",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "words": "vite-node scripts/build-words.ts",
    "sfx": "node scripts/gen-sfx.mjs",
    "art": "bash scripts/build-art.sh",
    "screenshots": "node scripts/screenshots.mjs && NO_BUILD=1 node scripts/mp-e2e.mjs --shots",
    "fonts": "python3 scripts/build-fonts.py",
    "autoplay": "node scripts/autoplay.mjs 1 6 11 12 116 17 121 22 126 201 203 27 29 131 301 302 303 900",
    "mp-relay": "node scripts/mp-relay.mjs",
    "mp-e2e": "node scripts/mp-e2e.mjs",
    "autoplay:listen": "LISTEN=1 node scripts/autoplay.mjs 1 2 11 12"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-barcode-scanner": "2.5.3",
    "@tauri-apps/plugin-store": "2.5.0",
    "galmuri": "2.40.3",
    "phaser": "3.90.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "ws": "8.22.0"
  }
}
