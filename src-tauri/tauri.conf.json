{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pocha Pop",
  "version": "0.3.0",
  "identifier": "cz.rogr.pochapop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pocha Pop 포차팝",
        "width": 450,
        "height": 800,
        "minWidth": 300,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#181425"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}